<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows only: the plugin drives the Teams desktop client through UI Automation. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- FlaUI references Windows Forms; this lets the Linux release CI build the plugin. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>default</LangVersion>
    <DebugType>embedded</DebugType>

    <!-- Produces a .deps.json and copies dependencies next to the plugin DLL
         so the host's AssemblyDependencyResolver can locate them. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- The SDK is shared from the host at runtime: compile against it but do
         not copy it into the plugin folder. -->
    <PackageReference Include="LoupixDeck.PluginSdk" Version="1.36.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- UI Automation client (MIT). -->
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translations the host reads off disk from the plugin folder at runtime. -->
    <Content Include="strings.*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Teams element ids and localized label patterns. -->
    <EmbeddedResource Include="Teams\selectors.json" LogicalName="LoupixDeck.Plugin.MSTeams.selectors.json" />
  </ItemGroup>

</Project>
